--!strict
-- Generated by scripts/upload_assets.py — safe to regenerate.
--
-- Keys are stable identifiers, not file paths. The game runs against
-- PLACEHOLDER until real IDs land, so a fresh clone is playable with zero
-- uploads. scripts/generate_icons.py writes PNGs using these same keys, so the
-- two scripts can never drift apart.

local AssetManifest = {}

AssetManifest.PLACEHOLDER = "rbxassetid://0"

