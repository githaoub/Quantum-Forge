--- The mesh for a blade, or nil when it has not been uploaded.
function AssetManifest.mesh(bladeId: string): MeshEntry?
	local entry = AssetManifest.Meshes[bladeId]
	if entry == nil or entry.id == "" or entry.id == AssetManifest.PLACEHOLDER then
		return nil
	end
	return entry
end

--- Store badge art for the gamepasses, keyed by the same snake_case name the
--- generator writes (`fast_forge`, `auto_vent`, `x2_star_matter`, `vip_aura`,
--- `eternal_forge`).
---
--- A third table, for the same reason `Meshes` is separate from `Assets`: these
--- are uploaded once per pass by hand and pasted into the Creator Dashboard, so
--- they are not part of `scripts/upload_assets.py`'s icon regeneration. That
--- script rewrites only `AssetManifest.Assets`, which leaves this block intact.
---
--- An empty string is the honest "no art yet" state. `ShopView` reads it as
--- "keep the category pill" rather than drawing an ImageLabel with no image,
--- which renders as a grey box and reads as a UI bug.
---
--- Use the **Image** asset id here, not a Decal id. An Open Cloud
--- `assetType: "Decal"` upload delivers a Decal object; `ImageLabel` wants a
--- bitmap, and a Decal id fails silently as an empty frame.
---
--- The id below is the second composition. The first one was a steel tool on an
--- obsidian disc: honest art, but measured at the 34.5 real px the store draws
--- it came out p50 = 28 luminance with 7% of pixels above 120, i.e. a black
--- circle. The field is gold and the subject is ink now: p50 = 112, 43% above
--- 120. Regenerate with `python scripts/generate_gamepass_icons.py`.
AssetManifest.GamepassIcons = {
	-- Game passes (permanent)
	fast_forge     = "rbxassetid://72607419302936",
	auto_vent      = "rbxassetid://125080652561026",
	x2_star_matter = "rbxassetid://118909357848534",
	vip_aura       = "rbxassetid://81353332723618",
	eternal_forge  = "rbxassetid://80507131219728",

	-- Boosts and utility (consumable)
	starter_forge     = "rbxassetid://84847200840711",
	instant_overdrive = "rbxassetid://86558007153668",
	instant_vent      = "rbxassetid://130555621223217",
	express_salvage   = "rbxassetid://80472428881811",
}

--- Edge length for a badge thumbnail, in px.
---
--- 420 is a size the thumbnail service actually serves; 512 is rejected
--- outright. 420 is ~12x the 34.5 real px the store draws, so the downsample
--- costs nothing. The UI badges draw at 44 to 56 design px, so the same edge
--- is reused for them rather than asking the CDN for a second size.
AssetManifest.THUMB_SIZE = 420

--- Custom currency art, keyed by the short currency code the HUD uses.
---
--- Separate from `Assets` and from the icon uploader because these three PNGs
--- are not generated by `scripts/generate_icons.py`; they come from the art
--- pipeline with a removed chroma background. `scripts/upload_currency.py`
--- fills this table and nothing else, the same contract `GamepassIcons` has.
---
--- Empty string is the honest "not uploaded" state. The HUD keeps its drawn
--- vector badge in that case, so a fresh clone and a failed upload both render
--- a real icon instead of an empty well.
AssetManifest.CurrencyArt = {
	sm = "99249193231278",
	as = "78550197900852",
	qc = "99765313424130",
}

--- Edge length used for currency thumbnails. The HUD draws them at 32 design
--- px, which is 26 real px at the 0.8 scale in the reference capture; 150 is
--- six times that, so a 4K client still has pixels to spend.
---
--- 150 is not a taste choice: the thumbnail service rejects arbitrary square
--- sizes and answers `invalid thumbnail size` for anything outside its table.
--- 150x150 and 420x420 are the two square options; 150 is the one that matches
--- the draw size without shipping a 420px bitmap for a 26px badge.
AssetManifest.CURRENCY_EDGE = 150

--- Image source for a gamepass badge, or "" when the art has not been uploaded.
---
--- Resolves through the **thumbnail CDN**, not `rbxassetid://`, because the raw
--- asset route is not reliable for Open Cloud uploads. Measured in this
--- workspace: `AssetService:CreateEditableImageAsync(Content.fromUri(
--- "rbxassetid://<id>"))` returns `HttpError` for the badge Image, the badge
--- Decal and an earlier badge Image alike, while
--- `rbxthumb://type=Asset&id=<id>&w=420&h=420` returns a real 420x420 RGBA
--- bitmap with the transparent corners intact (corner alpha 0, field
--- RGB 193,116,40). The thumbnail CDN is public and pre-rasterised, so it also
--- sidesteps asset-permission problems entirely.
---
--- Returns "" rather than a placeholder id on purpose: callers branch on empty
--- to pick a vector fallback, and `rbxassetid://0` would branch the wrong way.
function AssetManifest.gamepassIcon(key: string): string
	local id = AssetManifest.GamepassIcons[key]
	if id == nil or id == "" or id == AssetManifest.PLACEHOLDER then
		return ""
	end
	local numeric = string.match(id, "%d+")
	if numeric == nil then
		return ""
	end
	local edge = AssetManifest.THUMB_SIZE
	return string.format("rbxthumb://type=Asset&id=%s&w=%d&h=%d", numeric, edge, edge)
end

--- True when a gamepass badge has real art behind it.
function AssetManifest.hasGamepassIcon(key: string): boolean
	return AssetManifest.gamepassIcon(key) ~= ""
end

--- UI art for the Fleet, Rune and Tech lists, keyed by the slug the badge
