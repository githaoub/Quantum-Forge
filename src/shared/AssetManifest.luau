--- Resolves a key to a usable image string, always returning something the
--- ImageLabel constructor accepts.
function AssetManifest.get(key: string): string
	local id = AssetManifest.Assets[key]
	if id == nil or id == "" then
		return AssetManifest.PLACEHOLDER
	end
	return id
end

--- An uploaded blade mesh. `height` is the real world height in studs, taken
--- from the FBX at export time — the import does not guarantee a stud-per-unit
--- scale, so the runtime measures the MeshPart and rescales to this.
export type MeshEntry = {
	id: string,
	height: number,
	tris: number,
}

--- Blade id -> uploaded Model asset. Deliberately a second table: a mesh id and
--- an image id are the same shape (an rbxassetid string), so nothing stops you
--- passing one where the other belongs. An ImageLabel handed a model id renders
--- a grey box that reads as a UI bug rather than a manifest bug. Two tables,
--- two accessors, no crossover.
---
--- Written by `python scripts/upload_assets.py --mesh`. Every entry stays at
--- `rbxassetid://0` until a real upload runs, and `AssetManifest.mesh()` returns
--- nil for those, which is what keeps the primitive-built blade in the viewport.
