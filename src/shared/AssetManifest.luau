--- Image source for a list badge, or "" when the art has not been uploaded.
---
--- Resolved through the thumbnail CDN for the same measured reason the store
--- badges are: `rbxassetid://` against an Open Cloud Image upload does not
--- reliably rasterise inside an ImageLabel, while
--- `rbxthumb://type=Asset&id=<id>&w=420&h=420` returns a real bitmap.
---
--- Returns "" rather than a placeholder id so callers can skip the image and
--- keep a text-only row; `rbxassetid://0` would draw a grey box that reads as a
--- UI bug rather than missing art.
function AssetManifest.uiArt(key: string?): string
	if key == nil or key == "" then
		return ""
	end
	local id = AssetManifest.UiArt[key]
	if id == nil or id == "" or id == AssetManifest.PLACEHOLDER then
		return ""
	end
	local numeric = string.match(id, "%d+")
	if numeric == nil then
		return ""
	end
	local edge = AssetManifest.THUMB_SIZE
	return string.format("rbxthumb://type=Asset&id=%s&w=%d&h=%d", numeric, edge, edge)
end

--- True when a list badge has real art behind it.
function AssetManifest.hasUiArt(key: string?): boolean
	return AssetManifest.uiArt(key) ~= ""
end

