-- LihFolk vault art
-- ---------------------------------------------------------------------------

--- Material art from the LihFolk Vault pack, keyed by the surface it dresses.
---
--- A fifth table, for the same reason the other four are separate: this art is
--- third-party, copied out of the pack by `scripts/upload_lihfolk.py`, and it
--- must never be overwritten by an icon or currency regeneration. The pack's
--- licence allows use inside an experience and private uploads, so the ids are
--- private and the credit line lives in the handbook and the docs.
---
--- Only albedo (`Color.png`) is used. Normal and roughness maps are for meshes;
--- a UI band draws the albedo and nothing else.
AssetManifest.LihFolkArt = {
	band = "rbxassetid://102992694705193",
}

--- Square edge for a tiled material thumbnail. 420 is a served size, and the
--- band tiles it at 220 design px, so the downsample still has pixels to spare.
AssetManifest.LIHFOLK_EDGE = 420

--- Image source for a LihFolk surface, or "" when it has not been staged.
function AssetManifest.lihfolkArt(key: string?): string
	if key == nil or key == "" then
		return ""
	end
	local id = AssetManifest.LihFolkArt[key]
	if id == nil or id == "" or id == AssetManifest.PLACEHOLDER then
		return ""
	end
	local numeric = string.match(id, "%d+")
	if numeric == nil then
		return ""
	end
	local edge = AssetManifest.LIHFOLK_EDGE
	return string.format("rbxthumb://type=Asset&id=%s&w=%d&h=%d", numeric, edge, edge)
end

--- Six faces of a LihFolk sky, keyed the way `Sky` names them.
---
--- `rbxassetid://` and not the thumbnail CDN: a sky face is a texture, not a
--- bitmap drawn in a label, and the pack's faces are already 1024 square.
--- Empty entries mean the sky was never uploaded, and `LobbyService` keeps its
--- procedural lighting in that case rather than showing six black faces.
AssetManifest.LihFolkSky = {
	bk = "rbxassetid://127948154052495",
	dn = "rbxassetid://127509473987572",
	ft = "rbxassetid://93704348378287",
	lf = "rbxassetid://114213263580640",
	rt = "rbxassetid://76004822288802",
	up = "rbxassetid://71420941898331",
}

AssetManifest.SkyOrder = { "up", "dn", "ft", "bk", "lf", "rt" }

function AssetManifest.skyFace(key: string): string
	local id = AssetManifest.LihFolkSky[key]
	if id == nil or id == "" or id == AssetManifest.PLACEHOLDER then
		return ""
	end
	local numeric = string.match(id, "%d+")
	if numeric == nil then
		return ""
	end
	return "rbxassetid://" .. numeric
end

--- True only when all six faces resolved. A partially uploaded sky is worse
--- than no sky: five faces and a black hole is a bug the player can see.
function AssetManifest.hasSkybox(): boolean
	for _, key in AssetManifest.SkyOrder do
		if AssetManifest.skyFace(key) == "" then
			return false
		end
	end
	return true
end

--- Image source for one of the three custom currency assets, or "" when it has
--- not been uploaded.
---
--- Same thumbnail-CDN reason as `uiArt`: an Open Cloud Image upload does not
--- reliably rasterise through `rbxassetid://` inside an ImageLabel, while
--- `rbxthumb://type=Asset&id=<id>&w=&h=` returns a real bitmap. The source PNGs
--- already carry an alpha channel, so the label draws them over the pill instead
--- of over a keyed plate.
function AssetManifest.currencyArt(key: string?): string
	if key == nil or key == "" then
		return ""
	end
	local id = AssetManifest.CurrencyArt[key]
	if id == nil or id == "" or id == AssetManifest.PLACEHOLDER then
		return ""
	end
	local numeric = string.match(id, "%d+")
	if numeric == nil then
		return ""
	end
	local edge = AssetManifest.CURRENCY_EDGE
	return string.format("rbxthumb://type=Asset&id=%s&w=%d&h=%d", numeric, edge, edge)
end

--- True when a currency asset has been uploaded and can be drawn as a PNG.
function AssetManifest.hasCurrencyArt(key: string?): boolean
	return AssetManifest.currencyArt(key) ~= ""
end

--- True once an asset has been uploaded. UI uses this to decide whether to draw
--- a generated icon or fall back to a vector glyph.
function AssetManifest.isReal(key: string): boolean
	local id = AssetManifest.Assets[key]
	return id ~= nil and id ~= "" and id ~= AssetManifest.PLACEHOLDER
end

--- Every manifest key, in a stable order. Used by the uploader's verification
--- pass and by tests.
function AssetManifest.keys(): { string }
	local out = {}
	for key in AssetManifest.Assets do
		table.insert(out, key)
	end
	table.sort(out)
	return out
end

return AssetManifest
