--!strict
-- GENERATED by scripts/generate_vfx.py. Do not hand-edit the tables.
--
-- `Sheets` is a flat key -> asset-id map, the same shape as
-- `AssetManifest.Assets`, so the uploader can rewrite one block and the game
-- can build a key with `effect .. "_" .. layer`. `rbxassetid://0` means the
-- sheet has not been uploaded and the effect must fall back to procedural
-- drawing rather than rendering an empty ImageLabel.
--
-- The manifest is annotated rather than inferred on purpose: an inferred
-- table literal with named keys is *sealed*, and indexing it with a computed
-- string is a strict-mode error. Without the annotation `Sheets[key]` below
-- would not compile.

export type EffectMeta = {
	frames: number,
	fps: number,
	loop: boolean,
}

export type Manifest = {
	FrameSize: number,
	Columns: number,
	Rows: number,
	LayerOrder: { string },
	Sheets: { [string]: string },
	Effects: { [string]: EffectMeta },
	layer: (effect: string, layerName: string) -> string?,
	isReal: () -> boolean,
}

local PLACEHOLDER = "rbxassetid://0"

local VfxManifest = {} :: Manifest

VfxManifest.FrameSize = 512
VfxManifest.Columns = 4
VfxManifest.Rows = 4
VfxManifest.LayerOrder = { "glow", "rim", "body", "hotcore" }

VfxManifest.Sheets = {
	slash_glow = "rbxassetid://0",
	slash_rim = "rbxassetid://0",
	slash_body = "rbxassetid://0",
	slash_hotcore = "rbxassetid://0",
	impact_glow = "rbxassetid://0",
	impact_rim = "rbxassetid://0",
	impact_body = "rbxassetid://0",
	impact_hotcore = "rbxassetid://0",
	vent_glow = "rbxassetid://0",
	vent_rim = "rbxassetid://0",
	vent_body = "rbxassetid://0",
	vent_hotcore = "rbxassetid://0",
	overheat_glow = "rbxassetid://0",
	overheat_rim = "rbxassetid://0",
	overheat_body = "rbxassetid://0",
	overheat_hotcore = "rbxassetid://0",
	aura_glow = "rbxassetid://0",
	aura_rim = "rbxassetid://0",
	aura_body = "rbxassetid://0",
	aura_hotcore = "rbxassetid://0",
	particle_spark = "rbxassetid://0",
	particle_ember = "rbxassetid://0",
}

VfxManifest.Effects = {
	slash = { frames = 16, fps = 30, loop = false },
	impact = { frames = 16, fps = 26, loop = false },
	vent = { frames = 16, fps = 22, loop = false },
	overheat = { frames = 16, fps = 24, loop = false },
	aura = { frames = 16, fps = 20, loop = true },
}

--- Asset id for one layer of one effect, or nil when not uploaded.
function VfxManifest.layer(effect: string, layerName: string): string?
	local id = VfxManifest.Sheets[effect .. "_" .. layerName]
	if id == nil or id == PLACEHOLDER then
		return nil
	end
	return id
end

--- True when at least one sheet has been uploaded.
function VfxManifest.isReal(): boolean
	for _, id in VfxManifest.Sheets do
		if id ~= PLACEHOLDER then
			return true
		end
	end
	return false
end

return VfxManifest
